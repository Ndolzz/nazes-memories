# Salin file ini menjadi ".env" lalu isi dengan kredensial Supabase kamu.
# JANGAN commit file ".env" ke GitHub.

# Ambil dari: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Batas ukuran upload (dalam MB). Boleh diubah sesuai kuota free tier Supabase (1GB storage / 2GB bandwidth per bulan).
VITE_MAX_IMAGE_SIZE_MB=8
VITE_MAX_VIDEO_SIZE_MB=50
